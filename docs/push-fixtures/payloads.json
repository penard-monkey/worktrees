    "plaintext": { "v": 1, "kind": "input", "host": "Studio Mac", "repo": "/r/a", "slug": "ui", "project": "a", "place": "ui", "agent": "Claude", "waited_s": 30 },
    "aps": { "alert": { "title": "Worktrees", "body": "A session needs input" }, "mutable-content": 1, "interruption-level": "time-sensitive", "badge": 1 },
    "headers": { "apns-push-type": "alert", "apns-priority": "10" }, "expires_in": 3600, "collapse": true
  },
