{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "worktrees",
  "identifier": "net.casadelvalle.worktrees",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "worktrees",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5N0Q2RkY3Njk3N0YwQTgKUldTbzhIZHA5Mjk5aVp1VHp6Umh5S1FVUHg2QkNFbkZGVExZdG0vSlRaTWpaNVp0SStITTRNT2UK",
      "endpoints": [
        "https://github.com/penard-monkey/worktrees/releases/latest/download/latest.json"
      ]
    }
  }
}